PROGRAM_ENVIRONMENT=dev

# Display Sercvice Toggle
COMPOSE_PROFILES=display
# COMPOSE_PROFILES=

# DNS / Router Info
IP_ADDRESS=192.168.1.XXX
DNS_UPDATE_INTERVAL=300
ACME_EMAIL=you@example.com

# Radio Hosts
RADIO_SERVER_HOST=server.local-radio.localhost
RADIO_MIDDLEWARE_HOST=middleware.local-radio.localhost
RADIO_FRONTEND_HOST=local-radio.localhost

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=XXXXXXXXXX
CLOUDFLARE_API_TOKEN=XXXXXXXXXX